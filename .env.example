# Copy to .env and fill in real values. Never commit a populated .env.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0

# MySQL connection string used for the anomaly metadata + duplicate AP invoice tables.
DB_URI=mysql+pymysql://USER:PASSWORD@HOST:3306/joblog_metadata

METADATA_TABLE=anomaly_metadata
ANOMALY_TABLE=anomaly.duplicate_ap_invoice
COLUMN_INFO_TABLE=table_column_info
ANOMALY_TABLE_NAME=duplicate_ap_invoice

# Airflow SSH trigger
UBUNTU_HOST=ubuntu@172.31.25.132
SSH_KEY_PATH=C:\Users\you\path\to\key.pem
AIRFLOW_CMD=/home/ubuntu/run_airflow.sh dags trigger execute_adminFee_Data_Pipeline_v1

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
